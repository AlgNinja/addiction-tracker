# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env and adjust values if your configuration changes.
# In a real-world team or open source project, .env is gitignored, while
# .env.example is committed as a reference for new developers.
# ==============================================================================

PORT=5000
DB_HOST=localhost
DB_PORT=5432
DB_USER=tracker_user
DB_PASSWORD=tracker_password
DB_NAME=addiction_tracker

# Clerk Authentication (Get these for free at https://clerk.com)
# When set, all routes strictly enforce cryptographic JWT token verification!
CLERK_SECRET_KEY=sk_test_YOUR_CLERK_SECRET_KEY
CLERK_PUBLISHABLE_KEY=pk_test_YOUR_CLERK_PUBLISHABLE_KEY
